# ============================================================
# Общие
# ============================================================
BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Backend (backend/.env при локальном запуске без Docker)
# ============================================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shortener:shortener@localhost:5432/url_shortener
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ============================================================
# PostgreSQL (используется docker-compose для инициализации контейнера)
# ============================================================
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=url_shortener

# ============================================================
# Frontend (frontend/.env при локальном запуске без Docker)
# ============================================================
VITE_API_URL=http://localhost:3000
